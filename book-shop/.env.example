# สร้างโดย Claude หลังตั้งฐานข้อมูลในเครื่องเสร็จ
# ค่าเหล่านี้เป็นของ Supabase ที่รันใน Docker บนเครื่องนี้เท่านั้น ไม่ใช่ของจริง

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=<สคริปต์ setup เติมให้อัตโนมัติ>
SUPABASE_SERVICE_ROLE_KEY=<สคริปต์ setup เติมให้อัตโนมัติ>

# ใช้สร้างรหัสผ่านภายในของบัญชีลูกค้า (ไม่เคยส่งออกไปฝั่ง client)
APP_SECRET=<ข้อความสุ่มยาวๆ>
CRON_SECRET=<ข้อความสุ่มยาวๆ>

# ============================================================
#  LINE  — กรอกช่องล่างนี้จาก LINE Developers Console
#  วิธีหาแต่ละค่าอยู่ในหัวข้อ "ตั้งค่า LINE" ของ book-shop/README.md
# ============================================================

# ---------- จาก Messaging API channel (ตัวที่คุยกับลูกค้า) ----------

# Messaging API channel > Basic settings > Channel secret
# ใช้ตรวจลายเซ็น webhook — ถ้าผิด ข้อความจากลูกค้าจะถูกปฏิเสธทั้งหมด
LINE_CHANNEL_SECRET=

# Messaging API channel > Messaging API > Channel access token (long-lived)
LINE_CHANNEL_ACCESS_TOKEN=

# ---------- จาก LINE Login channel (ตัวที่มี LIFF) ----------
# สอง channel นี้คนละตัวกัน อย่าสลับค่ากัน

# LINE Login channel > Basic settings > Channel ID  (ตัวเลขล้วน)
# ใช้ยืนยัน ID token ที่ LIFF ส่งมา — ถ้าใส่ ID ของ Messaging API channel
# จะขึ้น "ตรวจสอบ LINE ID token ไม่ผ่าน" โดยไม่บอกสาเหตุ
LINE_LOGIN_CHANNEL_ID=

# LINE Login channel > LIFF > LIFF ID  (หน้าตาเช่น 2001234567-AbCdEfGh)
NEXT_PUBLIC_LIFF_ID=

# URL สาธารณะของเว็บ เช่น https://your-app.vercel.app  (ห้ามมี / ปิดท้าย)
NEXT_PUBLIC_APP_URL=

# ============================================================
#  เติมทีหลังเมื่อพร้อม
# ============================================================
PROMPTPAY_ID=

# ---------- ตรวจสลิปอัตโนมัติ (Slip2Go) ----------
# ไม่ใส่ = ระบบยังทำงานได้ปกติ แต่แอดมินต้องตรวจสลิปเองทุกใบ
# Secret Key จากหน้า API Connect > Authentication (ห้ามขึ้นต้นด้วย NEXT_PUBLIC_)
SLIP2GO_SECRET=

# ประเภทบัญชีรับเงิน ใช้กันสลิปที่โอนเข้าบัญชีคนอื่น
#   02001 = พร้อมเพย์เบอร์โทรศัพท์ (ค่าเริ่มต้น)
#   02003 = พร้อมเพย์บัตรประชาชน
#   01004 = ธนาคารกสิกรไทย ฯลฯ
SLIP2GO_ACCOUNT_TYPE=02001

# ชื่อบัญชีภาษาไทย ไม่ต้องใส่คำนำหน้า — ใส่แล้วตรวจแม่นขึ้น
# เพราะธนาคารมักปิดบังเลขพร้อมเพย์บางหลักในสลิป
SHOP_ACCOUNT_NAME_TH=
SHOP_NAME=
SHOP_ADDRESS=
SLIP_VERIFY_API_KEY=
FLASH_MERCHANT_ID=
FLASH_API_KEY=

# ---------- ShipPop (ตัวรวมขนส่งหลายเจ้า) ----------
# ไม่ใส่ = ปุ่ม "ดึงเลขพัสดุจาก ShipPop" จะไม่โผล่ แอดมินกรอกเลขพัสดุเองเหมือนเดิม
# คีย์ขอจากหน้า ShipPop > ตั้งค่า > API
# หมายเหตุ: คีย์ชุดเก่าเคยหลุดขึ้น git — ต้องใช้คีย์ใหม่เท่านั้น
SHIPPOP_API_KEY=

# sandbox (ทดสอบ ไม่เสียเงิน) = https://mkpservice.shippop.dev  <- ค่าเริ่มต้น
# production (เสียเงินจริง)   = https://mkpservice.shippop.com
SHIPPOP_BASE_URL=https://mkpservice.shippop.dev

# อีเมลที่ ShipPop ใช้ส่งใบจอง/ใบเสร็จ
SHIPPOP_EMAIL=

# ที่อยู่ผู้ส่ง (ร้าน) — ShipPop บังคับให้แยกฟิลด์ ใส่เป็นข้อความก้อนเดียวไม่ได้
# ระวัง: SUBDISTRICT = แขวง/ตำบล, DISTRICT = เขต/อำเภอ (ShipPop สลับชื่อกับที่เราคุ้น)
SHIPPOP_SENDER_NAME=
SHIPPOP_SENDER_ADDRESS=
SHIPPOP_SENDER_SUBDISTRICT=
SHIPPOP_SENDER_DISTRICT=
SHIPPOP_SENDER_PROVINCE=
SHIPPOP_SENDER_POSTCODE=
SHIPPOP_SENDER_TEL=

# ความลับที่แนบไปกับ callback URL ตอนจอง แล้วใช้ตรวจว่า webhook ที่ยิงกลับมาเป็นของจริง
# ShipPop ไม่ได้เซ็นลายเซ็นมาให้ ตัวนี้คือด่านเดียว — สุ่มยาวๆ มาสักชุด
SHIPPOP_WEBHOOK_SECRET=
