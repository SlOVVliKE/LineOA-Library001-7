{
  "name": "book-shop",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "bash scripts/setup-local.sh",
    "setup:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/setup-local.ps1",
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "tsx tests/money.test.ts",
    "cf:preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "cf:deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf:deploy-only": "opennextjs-cloudflare deploy",
    "cf:deploy-raw": "wrangler deploy",
    "cf:size": "opennextjs-cloudflare build && wrangler deploy --dry-run --outdir .wrangler/dry",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:studio": "supabase status",
    "db:push": "supabase db push"
  },
  "dependencies": {
    "@line/liff": "^2.26.0",
    "@supabase/ssr": "^0.5.2",
    "@supabase/supabase-js": "^2.45.4",
    "next": "15.5.24",
    "promptpay-qr": "^0.5.0",
    "qrcode": "^1.5.4",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@opennextjs/cloudflare": "^1.20.4",
    "wrangler": "^4.126.0",
    "@types/node": "^22.10.5",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3",
    "tsx": "^4.19.2",
    "supabase": "^2.0.0"
  }
}
